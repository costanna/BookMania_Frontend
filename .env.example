# BookMania Frontend - variables de entorno
# Copia este archivo como .env para desarrollo local.
# En producción la variable se define en Vercel (Settings -> Environment Variables).
#
# Vite incrusta las variables VITE_* en el bundle EN TIEMPO DE BUILD:
# si cambias VITE_API_URL en Vercel, hay que volver a desplegar.

# URL del backend, sin barra final.
#   Local:      http://localhost:8080
#   Producción: https://bookmania-backend.onrender.com (la que te dé Render)
VITE_API_URL=http://localhost:8080

# true = demo solo en el navegador (datos falsos en localStorage, sin backend)
# VITE_USE_MOCK=false
